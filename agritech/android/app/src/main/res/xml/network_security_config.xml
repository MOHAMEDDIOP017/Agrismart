<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Autorise HTTP clair vers le backend local (développement uniquement).
         ⚠️ En production : retirer ce bloc et utiliser HTTPS.
         Pour mettre à jour l'IP : ipconfig dans PowerShell → "Carte Wi-Fi → Adresse IPv4". -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Émulateur Android : 10.0.2.2 est l'alias vers localhost de l'hôte -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Téléphone physique sur Wi-Fi UADB — IP du PC (màj si changement de réseau) -->
        <domain includeSubdomains="false">10.86.209.5</domain>
    </domain-config>
</network-security-config>
