# ===================================================================
# AgriSmart Backend — Variables d'environnement
# Copiez ce fichier en .env et renseignez vos valeurs
# ===================================================================

# ── Application ────────────────────────────────────────────────────
APP_NAME=AgriSmart Backend
APP_VERSION=1.0.0
ENV=development
API_SECRET_KEY=votre_cle_aleatoire_secrete_tres_longue

# ── Firebase (Auth + Firestore + FCM uniquement — PAS Storage) ─────
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase_service_account.json
FIREBASE_PROJECT_ID=agrismart-final

# ── MinIO (stockage objet S3-compatible pour les images) ──────────
# En développement local (après `docker-compose up minio`) :
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=agrismartadmin
MINIO_SECRET_KEY=AgriSmart2026!Secret
MINIO_SECURE=false
MINIO_BUCKET_IMAGES=agrismart-images

# ── OpenWeatherMap ──────────────────────────────────────────────────
OPENWEATHER_API_KEY=votre_cle_openweathermap_ici

# ── Seuils IA ───────────────────────────────────────────────────────
SEUIL_CONFIANCE_DETECTION=0.7
TOP_K_RECOMMANDATIONS=3

# ── Chemins des modèles IA ──────────────────────────────────────────
MODELE_RECOMMANDATION_PATH=./models_ia/random_forest_crop.pkl
SCALER_PATH=./models_ia/scaler_crop.pkl
LABEL_ENCODER_PATH=./models_ia/label_encoder_crop.pkl
MODELE_DETECTION_PATH=./models_ia/efficientnet_plant_disease.tflite
CLASSES_DETECTION_PATH=./models_ia/plant_disease_classes.json
