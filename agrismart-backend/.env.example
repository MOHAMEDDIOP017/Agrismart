# ===================================================================
# AgriSmart Backend — Variables d'environnement
# Copiez ce fichier en .env et renseignez vos valeurs
# ===================================================================

# ── Application ────────────────────────────────────────────────────
APP_NAME=AgriSmart Backend
APP_VERSION=1.0.0
ENV=development
API_SECRET_KEY=votre_cle_aleatoire_secrete_tres_longue

# ── Firebase (Auth + Firestore + FCM uniquement — PAS Storage) ─────
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase_service_account.json
FIREBASE_PROJECT_ID=agrismart-jf-f1879

# ── MinIO (stockage objet S3-compatible pour les images) ──────────
# En développement local (après `docker-compose up minio`) :
MINIO_ENDPOINT=localhost:9000
# IP publique pour les URLs retournées aux clients mobiles (Wi-Fi local) :
MINIO_PUBLIC_ENDPOINT=<IP_DU_PC>:9000
# Identifiants MinIO — REMPLACEZ ces valeurs, elles ne sont que des exemples.
# Ce sont aussi les identifiants root du conteneur MinIO (docker-compose.yml).
MINIO_ACCESS_KEY=a_remplacer_access_key
MINIO_SECRET_KEY=a_remplacer_secret_key_longue_et_aleatoire
MINIO_SECURE=false
MINIO_BUCKET_IMAGES=agrismart-images

# ── Seuils IA ───────────────────────────────────────────────────────
TOP_K_RECOMMANDATIONS=3

# ── Modèle de recommandation de cultures ─────────────────────────────
# RandomForest multi-label (16 variables sol/climat/NDVI, 8 cultures)
MODELE_FINAL_PATH=./models_ia/modele_final.joblib

# ── Agent conversationnel IA (Qwen via OpenRouter) ──────────────────
# Créez une clé sur https://openrouter.ai puis renseignez-la ici.
OPENROUTER_API_KEY=
OPENROUTER_MODELE=qwen/qwen-2.5-72b-instruct
